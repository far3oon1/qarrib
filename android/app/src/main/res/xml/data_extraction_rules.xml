<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ (API 31) backup/transfer rules.

  Qarrib stores session tokens and patient/nurse PII in app storage. Exclude
  every domain from both cloud backup and device-to-device transfer so that
  health data is never copied off-device by the platform.

  Required because android:allowBackup="false" is NOT honoured by every OEM
  for device-to-device transfer on API 31+; these rules are authoritative.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
        <exclude domain="device_root" />
        <exclude domain="device_file" />
        <exclude domain="device_database" />
        <exclude domain="device_sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
        <exclude domain="device_root" />
        <exclude domain="device_file" />
        <exclude domain="device_database" />
        <exclude domain="device_sharedpref" />
    </device-transfer>
</data-extraction-rules>