{
  "appId": "com.qarrab.healthcare",
  "appName": "Qarrab Healthcare",
  "webDir": "frontend",
  "backgroundColor": "#F6F3EC",
  "server": {
    "androidScheme": "https",
    "iosScheme": "https",
    "cleartext": false,
    "allowNavigation": ["qarrib1.vercel.app", "qarrib.onrender.com", "*.onrender.com", "*.vercel.app"]
  },
  "android": {
    "allowMixedContent": false,
    "captureInput": true
  },
  "ios": {
    "contentInset": "automatic",
    "limitsNavigationsToAppBoundDomains": true
  }
}
